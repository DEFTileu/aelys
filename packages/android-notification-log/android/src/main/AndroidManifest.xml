<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Launchable apps are visible so the log can show "Kaspi" instead of a package name. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>
    <application>
        <!-- Only the system can bind it; the user grants access in Settings › Notification access. -->
        <service
            android:name="com.aelys.notificationlog.NotificationLogService"
            android:label="Aelys notification log"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
