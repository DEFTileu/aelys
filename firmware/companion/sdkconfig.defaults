# Chip: a fresh checkout has no sdkconfig, and without this IDF defaults to the plain ESP32
CONFIG_IDF_TARGET="esp32s3"

# Flash: 32 MB, QIO, 80 MHz
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Octal PSRAM, 80 MHz; memtest off for boot time
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# CPU, optimisation, caches
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# Watchdog and crash dump
CONFIG_ESP_TASK_WDT_PANIC=y
# Core dump format is always ELF in IDF v6.1 (hidden symbol)
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# Partitions
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# app_main runs identity_init (P-256 import, about 4.3 KB peak): the 3.5 KB default overflows
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# The ui task is created explicitly; app_main may run on either core
CONFIG_ESP_MAIN_TASK_AFFINITY_NO_AFFINITY=y

# mbedTLS: free buffers between TLS sessions
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
# mbedTLS/PSA allocations go to PSRAM; internal RAM stays for Wi-Fi and the UI
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Common CA bundle for the HTTPS link to the backend
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

# Console on the native USB-Serial/JTAG port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 1 ms tick: the ui task sleeps in 1..16 ms steps
CONFIG_FREERTOS_HZ=1000

# LVGL 9.6.0, mirrors sim/lv_conf.h. Allocator is ours (components/board/lv_port.c, PSRAM);
# the default font stays Montserrat 14, ui_theme_apply() sets Inter on every screen.
CONFIG_LV_COLOR_FORMAT_RGB565=y
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=5
CONFIG_LV_DPI_DEF=130
CONFIG_LV_USE_LOG=n
CONFIG_LV_USE_ASSERT_NULL=y
CONFIG_LV_USE_ASSERT_MALLOC=y
CONFIG_LV_USE_OBSERVER=n
CONFIG_LV_USE_FLOAT=n
# software renderer: RGB565 + byte-swapped RGB565 (the panel's order) targets, ARGB8888 layers
CONFIG_LV_USE_DRAW_SW=y
CONFIG_LV_DRAW_SW_SUPPORT_RGB565=y
CONFIG_LV_DRAW_SW_SUPPORT_RGB565_SWAPPED=y
CONFIG_LV_DRAW_SW_SUPPORT_RGB565A8=n
CONFIG_LV_DRAW_SW_SUPPORT_RGB888=n
CONFIG_LV_DRAW_SW_SUPPORT_XRGB8888=n
CONFIG_LV_DRAW_SW_SUPPORT_ARGB8888=y
CONFIG_LV_DRAW_SW_SUPPORT_ARGB8888_PREMULTIPLIED=n
CONFIG_LV_DRAW_SW_SUPPORT_L8=n
CONFIG_LV_DRAW_SW_SUPPORT_AL88=n
CONFIG_LV_DRAW_SW_SUPPORT_A8=y
CONFIG_LV_DRAW_SW_SUPPORT_I1=n
CONFIG_LV_USE_DRAW_SW_COMPLEX_GRADIENTS=n
CONFIG_LV_USE_VECTOR_GRAPHIC=n
CONFIG_LV_USE_SNAPSHOT=n
CONFIG_LV_USE_FONT_COMPRESSED=n
CONFIG_LV_USE_FONT_PLACEHOLDER=y
# no theme, no layouts, only the widgets the UI uses (label, image, canvas, QR code)
CONFIG_LV_USE_THEME_DEFAULT=n
CONFIG_LV_USE_THEME_SIMPLE=n
CONFIG_LV_USE_THEME_MONO=n
CONFIG_LV_USE_FLEX=n
CONFIG_LV_USE_GRID=n
CONFIG_LV_USE_LABEL=y
CONFIG_LV_USE_IMAGE=y
CONFIG_LV_USE_CANVAS=y
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_ARC=n
CONFIG_LV_USE_ARCLABEL=n
CONFIG_LV_USE_BAR=n
CONFIG_LV_USE_BUTTON=n
CONFIG_LV_USE_BUTTONMATRIX=n
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_CHECKBOX=n
CONFIG_LV_USE_DROPDOWN=n
CONFIG_LV_USE_IMAGEBUTTON=n
CONFIG_LV_USE_KEYBOARD=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_LINE=n
CONFIG_LV_USE_LIST=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_MSGBOX=n
CONFIG_LV_USE_ROLLER=n
CONFIG_LV_USE_SCALE=n
CONFIG_LV_USE_SLIDER=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_SPINNER=n
CONFIG_LV_USE_SWITCH=n
CONFIG_LV_USE_TEXTAREA=n
CONFIG_LV_USE_TABLE=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_LV_USE_WIN=n
# no LVGL examples or demos in the image
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n

# Release log level: runtime metrics are WARN so they still show; INFO lines are off
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# Bootloader: warnings only (saves boot time)
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
