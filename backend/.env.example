AELYS_DATABASE_URL=sqlite+aiosqlite:///./aelys.db
AELYS_SECRET_KEY=replace-with-a-long-random-secret
AELYS_ACCESS_TOKEN_MINUTES=15
AELYS_REFRESH_TOKEN_DAYS=30
# Optional until credentialed vendor execution is approved.
AELYS_RUNTIME_SIGNING_KEY=base64url-encoded-32-byte-ed25519-private-key
# Signed release manifest trust root; required before accepting isolation attestations.
AELYS_RUNTIME_TRUST_PUBLIC_KEY=base64url-encoded-32-byte-ed25519-public-key
AELYS_RUNTIME_TRUST_MANIFEST=base64url-encoded-signed-runtime-manifest
