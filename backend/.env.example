# Required application secret; use a unique random value of at least 32 characters.
AELYS_SECRET_KEY=replace-with-a-random-32-character-secret

# Recommended separate BYOK encryption key for operator deployments. If unset,
# local development falls back to AELYS_SECRET_KEY.
# AELYS_PROVIDER_ENCRYPTION_KEY=replace-with-a-separate-random-32-character-secret
# During rotation only, set the previous key as AELYS_PROVIDER_ENCRYPTION_KEY_OLD
# and run backend/scripts/rotate_provider_secrets.py. Never commit either value.

# Local development default. Use postgresql+asyncpg://... for a deployed instance.
AELYS_DATABASE_URL=sqlite+aiosqlite:///./aelys.db

# Optional owner/session tuning.
AELYS_ACCESS_TOKEN_MINUTES=15
AELYS_REFRESH_TOKEN_DAYS=30

# Gmail OAuth web client (enable Gmail API in Google Cloud).
# Register this exact callback URI on that client; use your web origin.
# AELYS_GMAIL_CLIENT_ID=
# AELYS_GMAIL_CLIENT_SECRET=
# AELYS_GMAIL_REDIRECT_URI=http://127.0.0.1:5173/api/v1/mail/gmail/callback

# Keep unset unless the signed runtime trust manifest is provisioned.
# AELYS_RUNTIME_SIGNING_KEY=
# AELYS_RUNTIME_TRUST_PUBLIC_KEY=
# AELYS_RUNTIME_TRUST_MANIFEST=

# Authentication. Owner creation with a password is off unless you enable it; a fresh server prints a one-time setup token instead.
# AELYS_PASSWORD_BOOTSTRAP_ENABLED=false
# AELYS_PASSWORD_LOGIN_ENABLED=true
# Number of reverse proxies in front of the server (X-Forwarded-For is ignored when 0).
# AELYS_TRUSTED_PROXY_COUNT=0
